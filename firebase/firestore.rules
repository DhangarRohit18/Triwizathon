rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 1. AUTHENTICATION & IDENTITY HELPERS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getAuthOrgId() {
      return request.auth.token.org_id != null 
        ? request.auth.token.org_id 
        : (getUserData() != null ? getUserData().org_id : null);
    }
    
    function getAuthRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : (getUserData() != null ? getUserData().role : 'operator');
    }
    
    function getAuthWarehouseId() {
      return request.auth.token.warehouse_id != null 
        ? request.auth.token.warehouse_id 
        : (getUserData() != null ? getUserData().warehouse_id : null);
    }

    // ==========================================
    // 2. TENANT & ROLE CHECK HELPERS
    // ==========================================
    function isSuperAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'super_admin' || getAuthRole() == 'super_admin');
    }
    
    function isOrgAdmin(orgId) {
      return isAuthenticated() && 
             (isSuperAdmin() || 
              ((getAuthRole() == 'org_admin') && (getAuthOrgId() == orgId)));
    }
    
    function isSupplyChainManager(orgId) {
      return isAuthenticated() && 
             (isOrgAdmin(orgId) || 
              ((getAuthRole() == 'supply_chain_manager') && (getAuthOrgId() == orgId)));
    }
    
    function isWarehouseManager(orgId) {
      return isAuthenticated() && 
             (isSupplyChainManager(orgId) || 
              ((getAuthRole() == 'warehouse_manager') && (getAuthOrgId() == orgId)));
    }
    
    function isOrgMember(orgId) {
      return isAuthenticated() && (isSuperAdmin() || getAuthOrgId() == orgId);
    }
    
    function isWarehouseAssigned(orgId, warehouseId) {
      return isOrgMember(orgId) && 
             (isSupplyChainManager(orgId) || getAuthWarehouseId() == warehouseId);
    }

    // ==========================================
    // 3. COLLECTION SECURITY RULES
    // ==========================================

    // 1. organizations
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow write: if isSuperAdmin();
    }

    // 2. users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOrgAdmin(resource.data.org_id));
      // Privileged roles must be assigned via trusted backend logic only
      allow create, delete: if isOrgAdmin(request.resource.data.org_id);
      allow update: if isOrgAdmin(resource.data.org_id) || 
                       (request.auth.uid == userId && 
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'org_id']));
    }

    // 3. warehouses
    match /warehouses/{warehouseId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if isOrgAdmin(request.resource.data.org_id);
    }

    // 4. products
    match /products/{productId} {
      allow read: if isAuthenticated() && isOrgMember(resource.data.org_id);
      allow write: if isSupplyChainManager(request.resource.data.org_id);
    }

    // 5. inventory (Aggregated by Warehouse & SKU)
    // Authoritative stock movements must pass through FastAPI backend with idempotency validation
    match /inventory/{invId} {
      allow read: if isOrgMember(resource.data.org_id) &&
                     (isSupplyChainManager(resource.data.org_id) || 
                      getAuthWarehouseId() == resource.data.warehouse_id);
      allow write: if false; // Backend authoritative only
    }

    // 6. inventory_batches (FEFO Expiry Tracking)
    match /inventory_batches/{batchId} {
      allow read: if isOrgMember(resource.data.org_id) &&
                     (isSupplyChainManager(resource.data.org_id) || 
                      getAuthWarehouseId() == resource.data.warehouse_id);
      allow write: if false; // Backend authoritative only
    }

    // 7. inventory_movements (Append-only Immutable Ledger)
    match /inventory_movements/{movementId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow create, update, delete: if false; // Strictly immutable backend ledger!
    }

    // 8. orders (Healthcare Facility & Customer Orders)
    match /orders/{orderId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if false; // Backend managed workflow
    }

    // 9. transfers (Inter-Warehouse Transfers)
    match /transfers/{transferId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if false; // Backend authoritative only (preserves two-phase commit)
    }

    // 10. transfer_items (Transfer Line Items)
    match /transfer_items/{itemId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if false; // Backend managed
    }

    // 11. demand_history (Consumption & Demand Time-series)
    match /demand_history/{historyId} {
      allow read: if isSupplyChainManager(resource.data.org_id);
      allow write: if false; // Analytical ingestion
    }

    // 12. forecasts (Predicted Demand Forecasts)
    match /forecasts/{forecastId} {
      allow read: if isSupplyChainManager(resource.data.org_id);
      allow write: if false; // ML / Statistical engine generated
    }

    // 13. optimization_runs (Google OR-Tools Solver Runs)
    match /optimization_runs/{runId} {
      allow read: if isSupplyChainManager(resource.data.org_id);
      allow write: if false; // Solver engine generated
    }

    // 14. allocation_recommendations (OR-Tools Proposed Distribution)
    match /allocation_recommendations/{recId} {
      allow read: if isSupplyChainManager(resource.data.org_id);
      allow write: if false; // Solver engine generated
    }

    // 15. iot_devices (Cold Chain Sentinels & Telemetry Gateways)
    match /iot_devices/{deviceId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if isOrgAdmin(request.resource.data.org_id);
    }

    // 16. sensor_readings (Time-series Environmental Readings)
    match /sensor_readings/{readingId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if false; // IoT ingestion API only
    }

    // 17. alerts (Cold Chain Excursions & Threshold Breaches)
    match /alerts/{alertId} {
      allow read: if isOrgMember(resource.data.org_id);
      // Operators and Managers can acknowledge active alerts directly
      allow update: if isOrgMember(resource.data.org_id) && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledged_by', 'acknowledged_at']);
      allow create, delete: if false; // Alert engine only
    }

    // 18. notification_logs (FCM Push & WhatsApp Records)
    match /notification_logs/{logId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if false; // Notification dispatcher only
    }

    // 19. audit_logs (Immutable Regulatory Compliance Audit Trail)
    match /audit_logs/{auditId} {
      allow read: if isOrgAdmin(resource.data.org_id);
      allow write: if false; // Strictly immutable audit trail
    }
  }
}
