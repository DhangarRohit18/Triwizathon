rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'super_admin' || getUserData().role == 'super_admin');
    }
    
    function isOrgAdmin(orgId) {
      return isAuthenticated() && 
             (isSuperAdmin() || 
             ((request.auth.token.role == 'org_admin' || getUserData().role == 'org_admin') && 
              (request.auth.token.org_id == orgId || getUserData().org_id == orgId)));
    }
    
    function isOrgMember(orgId) {
      return isAuthenticated() && 
             (isSuperAdmin() || request.auth.token.org_id == orgId || getUserData().org_id == orgId);
    }
    
    function isWarehouseAssigned(orgId, warehouseId) {
      return isOrgMember(orgId) && 
             (request.auth.token.role in ['super_admin', 'org_admin', 'supply_chain_manager'] ||
              getUserData().warehouse_id == warehouseId);
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow write: if isSuperAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOrgAdmin(resource.data.org_id));
      allow write: if isOrgAdmin(request.resource.data.org_id);
    }

    // Warehouses & Destinations
    match /warehouses/{warehouseId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if isOrgAdmin(request.resource.data.org_id);
    }
    
    match /destinations/{destId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if isOrgAdmin(request.resource.data.org_id);
    }

    // Products Catalog
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isOrgAdmin(request.resource.data.org_id);
    }

    // Inventory and Batches (Authoritative writes enforced via Backend Cloud Functions / API)
    match /inventory/{invId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if false; // Authoritative backend only
    }

    match /inventory_batches/{batchId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if false; // Authoritative backend only
    }

    // Append-only Inventory Movements Ledger
    match /inventory_movements/{movementId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow create: if false; // Authoritative backend only
      allow update, delete: if false; // Strictly immutable!
    }

    // Inter-Warehouse Transfers
    match /transfers/{transferId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if false; // Authoritative backend only
    }

    // Optimization Runs & Recommendations
    match /optimization_runs/{runId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if false; // Generated by OR-Tools backend
    }

    // IoT Telemetry & Devices
    match /iot_devices/{deviceId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if isOrgAdmin(request.resource.data.org_id);
    }

    match /sensor_readings/{readingId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if false; // Ingested via Authenticated IoT API
    }

    match /alerts/{alertId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow update: if isOrgMember(resource.data.org_id) && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledged_by', 'acknowledged_at']);
      allow create, delete: if false;
    }

    // WhatsApp Notification & Audit Logs
    match /notification_logs/{logId} {
      allow read: if isOrgMember(resource.data.org_id);
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isOrgAdmin(resource.data.org_id);
      allow write: if false; // Strictly immutable backend ledger
    }
  }
}
