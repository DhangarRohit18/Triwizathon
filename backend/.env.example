# =================================================================
# STOCKPILOT AI — Environment Configuration Template
# =================================================================

# Security & Session Authentication
SECRET_KEY=stockpilot-super-secret-production-key-triwizathon-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase & Firestore Configuration
# Provide path to your serviceAccountKey.json for production Cloud Firestore.
# If omitted or empty, STOCKPILOT AI runs its zero-config persistent transactional datastore.
FIREBASE_PROJECT_ID=stockpilot-ai-triwiz
FIREBASE_CREDENTIALS_PATH=
USE_FIREBASE_MOCK=true

# Meta WhatsApp Business Platform Cloud API
# Replace with credentials from Meta for Developers (developers.facebook.com)
WHATSAPP_API_TOKEN=mock_whatsapp_token_test_123
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_VERIFY_TOKEN=stockpilot_triwiz_verify_2026
WHATSAPP_APP_SECRET=mock_meta_app_secret_abc123

# WhatsApp Admin Enrollment & Bootstrap
BOOTSTRAP_ADMIN_PHONE=+919876543210
ADMIN_BOOTSTRAP_SECRET=bootstrap-secret-change-in-production

# IoT Sensor Gateway Telemetry Key
# Must match the X-IoT-Key, X-Device-API-Key, or X-API-Key header sent by physical ESP32 devices
IOT_API_KEY=stockpilot-iot-secure-esp32-auth-token

# Chrome Manifest V3 Extension Companion Key
EXTENSION_API_KEY=stockpilot-ext-v3-authorized-key
