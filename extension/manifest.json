{
  "manifest_version": 3,
  "name": "StockPilot AI — Distribution & Inventory Companion",
  "version": "1.3.0",
  "description": "Enterprise supply chain companion for warehouse stock lookup, cold-chain alerts, and role-authorized transfer actions.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "StockPilot AI Companion"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.stockpilot.ai/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.stockpilot.ai/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
